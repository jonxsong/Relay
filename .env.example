# Local infrastructure. Copy to .env; never commit real secrets.
POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay-local-only
DATABASE_URL=postgres://relay:relay-local-only@localhost:5432/relay?sslmode=disable
NATS_URL=nats://localhost:4222

# Runtime
RELAY_ENV=development
RELAY_LOG_LEVEL=info
RELAY_HTTP_ADDR=:8080
RELAY_PROVIDER=mock
RELAY_DEFAULT_MODEL=gpt-5-mini
RELAY_GLOBAL_CONCURRENCY=100
RELAY_RUN_CONCURRENCY=10
RELAY_MAX_REQUEST_BYTES=1048576

# Optional live provider. Keep the value in a local ignored env file.
OPENAI_API_KEY=

